# Finvisor backend configuration.
#
# Copy to `.env` and fill in the keys you actually intend to use:
#   cp .env.example .env
#
# Every variable below is read somewhere in this backend (api.py, agent.py, llm_config.py,
# mongo_client.py) or by a provider SDK that picks it up from the environment. All of them
# have working defaults except the API keys, so the shortest useful .env is a single
# provider key plus TAVILY_API_KEY.
#
# Nothing here is secret -- never commit a filled-in .env.


# ---------------------------------------------------------------------------
# Model routing (llm_config.py)
#
# Each task has a *role* with an ordered, comma-separated provider chain. Providers are
# tried left to right and the next one is used automatically when the current one errors
# (rate limit, exhausted quota, bad key). Valid providers: openai, gemini, claude, groq,
# ollama (ollama is local-only and has no vision-capable default beyond llava).
#
# Roles: grader    = cheap per-query yes/no relevance check, runs on every request
#        synthesis = the actual advisory answer; quality matters most here
#        vision    = reading tables/charts off a rendered PDF page (no groq: no vision model)
#
# Within a provider the model is resolved per role -- {PROVIDER}_{ROLE}_MODEL wins over the
# provider-wide {PROVIDER}_MODEL -- so the cheap high-frequency grader and the expensive
# synthesis step don't have to share one model id.
# ---------------------------------------------------------------------------
GRADER_PROVIDERS=openai,groq
SYNTHESIS_PROVIDERS=openai,groq
VISION_PROVIDERS=openai

# Legacy single-provider vars, kept for backward compatibility. Only consulted when the
# matching *_PROVIDERS var above is unset, and they disable fallback (single-item chain).
# Leave blank unless you specifically want the old behaviour.
# LLM_PROVIDER=
# VISION_PROVIDER=


# ---------------------------------------------------------------------------
# Provider credentials + model names
# The *_API_KEY variables are read by the provider SDKs themselves, not by this code.
# ---------------------------------------------------------------------------

# --- OpenAI --- https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Defaults if unset: gpt-4.1-mini for grading, gpt-4.1 for synthesis and vision.
OPENAI_GRADER_MODEL=gpt-4.1-mini
OPENAI_SYNTHESIS_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1
# One model for every role (only used where no role-specific var above is set).
# OPENAI_MODEL=
# Azure OpenAI or any OpenAI-compatible gateway.
# OPENAI_BASE_URL=

# Google Gemini -- https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-latest

# Anthropic Claude -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Groq (fast + generous free tier; the default grader) -- https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (fully local, no key required). Only used if listed in a chain above.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava


# ---------------------------------------------------------------------------
# Web search (agent.py's fallback when local documents aren't relevant)
# https://app.tavily.com/home
# ---------------------------------------------------------------------------
TAVILY_API_KEY=


# ---------------------------------------------------------------------------
# Data stores
#
# MongoDB holds document metadata, user feedback, and GridFS copies of uploaded PDFs and
# generated charts. It is NOT required for retrieval -- ChromaDB (a local directory,
# ./chroma_db) is the vector store, and the API stays up and serving /chat if MongoDB is
# unreachable. docker-compose.yml overrides MONGODB_URI to point at its own `mongo` service.
#
# Redis is an optional cache for chart images and yfinance fundamentals; the agent logs a
# warning and runs uncached when it can't connect.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
# Atlas example: mongodb+srv://user:password@cluster0.mongodb.net/
MONGODB_DB_NAME=finvisor

REDIS_URL=redis://localhost:6379


# ---------------------------------------------------------------------------
# Authentication (auth.py)
# ---------------------------------------------------------------------------

# Secret key for signing JWT tokens. MUST be changed in production -- the default value is
# intentionally obvious so it is never accidentally deployed.
JWT_SECRET_KEY=finvisor-dev-secret-change-in-production

# Token lifetime in minutes. Default 1440 = 24 hours.
JWT_EXPIRY_MINUTES=1440


# ---------------------------------------------------------------------------
# HTTP layer (api.py)
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call this API. Both localhost and
# 127.0.0.1 are listed because a browser treats them as different origins. Add your
# deployed frontend URL here (no trailing slash).
#
# "*" is accepted as a demo-only shortcut and forces credentialed requests off -- a wildcard
# combined with credentials is rejected by every browser, which is why it can't be the
# default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Root log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Maximum accepted upload size, in megabytes (/ingest returns 413 above this).
MAX_UPLOAD_MB=25

# Wall-clock deadlines, in seconds, before a request is abandoned with a 504. Chat is
# generous because one turn can involve retrieval, grading, web search, tool calls and
# synthesis, each with provider fallback.
CHAT_TIMEOUT_SECONDS=180
SUGGEST_TIMEOUT_SECONDS=90

# Size of the dedicated threadpool that runs blocking agent/LLM work. Roughly the number of
# chat requests that can be in flight at once; raise it only if the model providers can
# actually keep up.
API_WORKER_THREADS=8
